{
  "name": "plazr",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-tenant South African street market vendor & event planner platform",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "tsc --noEmit",
    "deploy:aws": "powershell -ExecutionPolicy Bypass -File scripts/deploy-aws.ps1",
    "deploy:s3": "powershell -ExecutionPolicy Bypass -File scripts/deploy-s3-cloudfront.ps1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
